{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "enabled": { "type": "boolean" },
    "nameservers": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "authorityNodes": { "type": "object" },
    "domains": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["hostname", "service", "class", "probePath"],
        "properties": {
          "hostname": { "type": "string", "minLength": 3 },
          "service": { "type": "string", "minLength": 1 },
          "class": { "type": "string", "minLength": 1 },
          "probePath": { "type": "string", "pattern": "^/" },
          "publicationRef": {
            "type": "object",
            "additionalProperties": false,
            "required": ["namespace", "name"],
            "properties": {
              "namespace": { "type": "string", "minLength": 1 },
              "name": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "services": { "type": "object" },
    "publicEdges": { "type": "array" },
    "rbac": {
      "type": "object",
      "properties": { "mutateIngresses": { "type": "boolean" } }
    },
    "service": {
      "type": "object",
      "properties": {
        "type": { "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "externalTrafficPolicy": { "enum": ["", "Cluster", "Local"] }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "enabled": { "const": true } } },
      "then": {
        "properties": {
          "nameservers": { "minItems": 1 },
          "authorityNodes": { "minProperties": 1 },
          "publicEdges": { "minItems": 1 }
        },
        "anyOf": [
          { "properties": { "domains": { "minItems": 1 } } },
          { "properties": { "services": { "minProperties": 1 } } }
        ]
      }
    }
  ]
}
